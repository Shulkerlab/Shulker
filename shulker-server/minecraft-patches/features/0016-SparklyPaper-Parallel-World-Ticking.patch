     // Paper start - Add tick times API and /mspt command
+    // SparklyPaper start - track world's MSPT (Shulker: shared by the parallel and sequential paths)
+    private void tickLevel(final ServerLevel level, final java.util.function.BooleanSupplier haveTime) {
+        try {
+            long i = Util.getNanos();
+            level.tick(haveTime);
+            long j = Util.getNanos() - i;
+            // These are from the "tickServer" function
+            level.tickTimes5s.add(this.tickCount, j);
+            level.tickTimes10s.add(this.tickCount, j);
+            level.tickTimes1m.add(this.tickCount, j);
+        } catch (Throwable t) {
+            CrashReport report = CrashReport.forThrowable(t, "Exception ticking world");
+            level.fillReportDetails(report);
+            throw new ReportedException(report);
+        }
+    }
+    // SparklyPaper end - track world's MSPT
+

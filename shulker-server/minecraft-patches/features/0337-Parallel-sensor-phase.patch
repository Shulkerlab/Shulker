+    // Shulker start - parallel sensors (DivineMC)
+    /** Whether {@link #tick} would run this sensor this tick. */
+    public final boolean shulker$isDue() {
+        return this.timeToTick <= 1L;
+    }
+
+    /**
+     * Runs the sensor ahead of the mob's brain tick. The timer is left one higher than
+     * {@link #tick} would leave it, because the brain tick that follows still counts it down:
+     * the sensor keeps its vanilla interval.
+     */
+    public final void shulker$tickAhead(final ServerLevel level, final E body) {
+        if (this.scanRateCache == Integer.MIN_VALUE) {
+            this.scanRateCache = this.getScanRate(level, body);
+        }
+        this.timeToTick = this.scanRateCache + 1L;
+        this.updateTargetingConditionRanges(body);
+        this.doTick(level, body);
+    }
+    // Shulker end - parallel sensors

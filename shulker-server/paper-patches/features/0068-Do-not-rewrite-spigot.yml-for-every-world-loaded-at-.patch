 <126924958+Aegyip@users.noreply.github.com>
Date: Wed, 21 Oct 2026 15:50:41 +0300
Subject: [PATCH] Do not rewrite spigot.yml for every world loaded at runtime

SpigotConfig.readConfig saved the whole file each time a world's settings were read. Worlds loaded after startup now skip that save; their settings are unchanged.

diff --git a/src/main/java/org/spigotmc/SpigotConfig.java b/src/main/java/org/spigotmc/SpigotConfig.java
index 2fb235c0dd463fe9bad3c08ed5077a61c854fab8..ce07b3beb14c482c42d07c48b68ff3a49ad769cb 100644
--- a/src/main/java/org/spigotmc/SpigotConfig.java
+++ b/src/main/java/org/spigotmc/SpigotConfig.java
@@ -95,7 +95,7 @@ public class SpigotConfig {
             }
         }
 
-        try {
+        if (dev.shulker.server.world.WorldConfigSaves.shouldSave(instance)) try { // Shulker - do not rewrite the global file for every world loaded at runtime
             SpigotConfig.config.save(SpigotConfig.CONFIG_FILE);
         } catch (IOException ex) {
             Bukkit.getLogger().log(Level.SEVERE, "Could not save " + SpigotConfig.CONFIG_FILE, ex);
